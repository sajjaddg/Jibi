{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muchtoman-billing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",

  // A third Worker, apart from sync for the reason sync is apart from rates: the payment
  // providers' keys and the entitlement signing key must never sit beside households' data, and
  // nothing here ever learns a household id.
  "routes": [{ "pattern": "pay.muchtoman.com", "custom_domain": true }],

  // Off. Iran sinkholes workers.dev, and no client is ever pointed there.
  "workers_dev": false,
  "preview_urls": false,

  // Licenses and nothing about people: no household id, address, phone number or e-mail
  // (migrations/). `database_id` is a placeholder on purpose, so a deploy fails until the owner
  // has created the database (`wrangler d1 create muchtoman-billing`) and put its id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muchtoman-billing",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Every call, per address and per location. Money is where abuse comes.
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "3001", "simple": { "limit": 60, "period": 60 } }],

  // The code's own console.error lines, and nothing else: invocation logs would keep URLs,
  // headers and the caller's address.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
