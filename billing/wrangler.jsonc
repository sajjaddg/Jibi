{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muchtoman-billing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",

  // A third Worker, apart from sync for the reason sync is apart from rates: the payment
  // providers' keys and the entitlement signing key must never sit beside households' data, and
  // nothing here ever learns a household id.
  "routes": [{ "pattern": "pay.muchtoman.com", "custom_domain": true }],

  // Off. Iran sinkholes workers.dev, and no client is ever pointed there.
  "workers_dev": false,
  "preview_urls": false,

  // Licenses and nothing about people: no household id, address, phone number or e-mail
  // (migrations/). `database_id` is a placeholder on purpose, so a deploy fails until the owner
  // has created the database (`wrangler d1 create muchtoman-billing`) and put its id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muchtoman-billing",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Every call, per address and per location. Money is where abuse comes.
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "3001", "simple": { "limit": 60, "period": 60 } }],

  // Staging: its own Worker name, domain, database and rate-limit counters, for trying a change
  // where no money and no license is real. Providers are called in their sandbox. Nothing is
  // inherited on purpose, so every binding the Worker uses is named again. Never workers.dev.
  "env": {
    "staging": {
      "name": "muchtoman-billing-staging",
      "routes": [{ "pattern": "staging-pay.muchtoman.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      // Placeholder, as above: `wrangler d1 create muchtoman-billing-staging`.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "muchtoman-billing-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "PAYMENTS": "sandbox" },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "muchtoman_billing_staging" }],
      "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "4001", "simple": { "limit": 60, "period": 60 } }],
      "observability": { "enabled": true, "logs": { "invocation_logs": false } }
    }
  },

  // `live` calls the providers for real; only the exact word does. Read by #46 and #47.
  "vars": { "PAYMENTS": "live" },

  // One write-only dataset: per request the endpoint, status, client version and error code
  // (src/metrics.ts). Nothing that says whose.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "muchtoman_billing" }],

  // The code's own console.error lines, and nothing else: invocation logs would keep URLs,
  // headers and the caller's address.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
